# قاعدة البيانات (محلياً عبر docker-compose، غيّرها في أي بيئة أخرى)
DB_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://meethaq_app:CHANGE_ME@localhost:5432/meethaq

# مفاتيح JWT — يجب أن تكون عشوائية وطويلة (32+ حرف) ومختلفة بين البيئات
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_LONG_STRING
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_LONG_STRING

# مفتاح تشفير الحقول الحساسة على مستوى التطبيق (رقم الهوية، سرّ TOTP)
APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY

# خدمات المحادثة القانونية وتحليل العقود
ANTHROPIC_API_KEY=CHANGE_ME
VOYAGE_API_KEY=CHANGE_ME

# إعدادات عامة
PORT=4000
NODE_ENV=development
COOKIE_DOMAIN=localhost
